{
  "bsonType": "object",
  "required": [
    "identityHash",
    "scope",
    "period",
    "count",
    "limit",
    "createdAt",
    "updatedAt"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "Hash of scope, period and device identity."
    },
    "identityHash": {
      "bsonType": "string"
    },
    "scope": {
      "bsonType": "string",
      "enum": ["hour", "day"]
    },
    "period": {
      "bsonType": "string"
    },
    "count": {
      "bsonType": "int",
      "minimum": 1
    },
    "limit": {
      "bsonType": "int",
      "minimum": 1
    },
    "createdAt": {
      "bsonType": "long"
    },
    "updatedAt": {
      "bsonType": "long"
    }
  }
}
